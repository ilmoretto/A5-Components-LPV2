<table class="table table-striped">
	<thead>
		<tr>
			<th scope="col">Nome</th>
			<th scope="col">Preço</th>
			<th scope="col">Quantidade</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var p in Produtos)
		{
			<tr>
				<td>@p.Nome</td>
				<td>R$@p.Preco.ToString("N2")</td>
				<td>@p.Quantidade</td>
			</tr>
		}
	</tbody>
</table>

@code {
	[Parameter]
	public List<Produto> Produtos { get; set; } = new();
}
